{
  "name": "@tishlang/tishdoc-render-html",
  "version": "0.1.0",
  "description": "TishDoc AST → semantic HTML + default print CSS",
  "license": "MIT",
  "type": "module",
  "tish": {
    "module": "./src/main.tish"
  },
  "main": "./src/main.tish",
  "exports": {
    ".": {
      "tish": "./src/main.tish",
      "import": "./dist/tishdoc-render-html.js",
      "default": "./dist/tishdoc-render-html.js"
    }
  },
  "dependencies": {
    "@tishlang/tish-syntax-highlight": "*"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tishlang/tish": "1.9.2",
    "semantic-release": "^25.0.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tishlang/tishdoc-render-html.git"
  },
  "scripts": {
    "build": "tish build --target js --no-optimize src/main.tish -o dist/tishdoc-render-html.js && TISH_EXPORT_OUT=dist/tishdoc-render-html.js TISH_EXPORT_NAMES=renderToHtmlFragment,renderToHtmlDocument,defaultPrintCss node scripts/append-exports.mjs",
    "test": "node ./test/run_node.mjs"
  },
  "peerDependencies": {
    "@tishlang/tish-syntax-highlight": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md"
  ]
}
